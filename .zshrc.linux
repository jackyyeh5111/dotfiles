source /usr/share/doc/fzf/examples/key-bindings.zsh
# Ctrl+O: fzf history search, same as Ctrl+R
bindkey '^O' fzf-history-widget

# fzf-tab: show Tab completions in fzf
zstyle ':completion:*' menu no  # let fzf-tab replace zsh's own menu
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
# Press ; to number the lines, then a number to pick that line
zstyle ':fzf-tab:*' fzf-flags --jump-labels=1234567890
zstyle ':fzf-tab:*' fzf-bindings ';:jump-accept'

# Fuzzy finder related
alias vimf='vim $(fzf --preview="batcat --color=always {}")'
alias cdf='cd $(fd --type d . | fzf)'

alias cpw='pwd | tee >(xclip -selection clipboard)'
alias cpaf='fzf --preview="batcat --color=always {}" | xargs realpath | tee >(xclip -selection clipboard)'
alias cpf='fzf --preview="batcat --color=always {}" | tee >(xclip -selection clipboard)'
ff() {
    "$@" | fzf | tee >(xclip -selection clipboard)
}

### Use fzf for preview git operation ###
# Navigate files with arrows
# TAB to multi-select
# Enter → diff
# CTRL-A → add
# CTRL-R → restore
git_interactive() {
  local out key files_array file

  # Run fzf with preview and key bindings
  out=$(
    git status -uno -s | awk '{print $2}' | \
      fzf -m \
        --bind "enter:accept" \
        --bind "ctrl-a:accept" \
        --bind "ctrl-r:accept" \
        --expect=enter,ctrl-a,ctrl-r \
        --preview 'git diff --color=always -- {}' \
        --preview-window=right:70%
  ) || return

  # First line = key pressed, rest = selected files
  key=$(head -n1 <<< "$out")
  files_array=()
  while IFS= read -r file; do
    [[ -n "$file" ]] && files_array+=("$file")
  done < <(tail -n +2 <<< "$out")

  if [[ ${#files_array[@]} -eq 0 ]]; then
    echo "No files selected."
    return
  fi

  # Perform action based on pressed key
  case "$key" in
    ctrl-a)
      git add "${files_array[@]}"
      echo "Added files:"
      for f in "${files_array[@]}"; do
        echo "$f"
      done
      ;;
    ctrl-r)
      git restore "${files_array[@]}"
      echo "Restored files:"
      for f in "${files_array[@]}"; do
        echo "$f"
      done
      ;;
    *)
      git diff "${files_array[@]}"
      ;;
  esac
}

