# format alias
alias mxstyle='astyle --align-pointer=type --align-reference=name --style=kr --add-braces --attach-return-type-decl --keep-one-line-statements --convert-tabs --close-templates --max-code-length=200 --pad-comma --pad-oper --indent-col1-comments --indent-preproc-define --indent-preproc-block --indent-labels --indent-switches --indent-modifiers --indent=spaces=4 --break-closing-braces --keep-one-line-blocks --lineend=linux'
