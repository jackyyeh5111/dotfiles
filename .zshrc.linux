alias cdfp='workon mx2p2 && /home/jackyyeh/memryx/MX_API/samples/multi_dfp/conditional_pipe'
alias hr='herdr'
alias j='just -g'  # global recipes in ~/.justfile, from any folder
alias gds='git -c delta.side-by-side=true diff'  # side by side diff; replaces oh-my-zsh's gds (git diff --staged)

# Standard listing replacement
alias ls='eza --icons=auto'

# Detailed list view (replacing `ll` / `ls -l`)
alias ll='eza -l --git --header --icons=auto'

# Detailed list including hidden files (replacing `la` / `ls -la`)
alias la='eza -la --git --header --icons=auto'

# Quick tree view up to 2 levels deep
alias lt='eza -T -L 2 --icons=auto'

# Complete tree view including hidden files, ignoring .git
alias lta='eza -Ta -L 3 -I ".git" --icons=auto'

export PATH="$HOME/.local/bin:$PATH"
