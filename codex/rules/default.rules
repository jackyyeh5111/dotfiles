prefix_rule(pattern=["dmesg"], decision="allow")
prefix_rule(pattern=["./build/mx_bench"], decision="allow")
prefix_rule(pattern=["cmake", "--build", "build"], decision="allow")
prefix_rule(pattern=["tail", "-65"], decision="allow")
prefix_rule(pattern=["ps", "-C", "mx_bench"], decision="allow")
prefix_rule(pattern=["git", "add", "nvim/lua/plugins.lua"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["/usr/bin/time", "-f", "WALL_SECONDS=%e", "./build/mx_accl/all_tests", "--gtest_throw_on_failure", "--local", "--gtest_filter=mx_bench_tests.default_benchmarks_every_model"], decision="allow")
