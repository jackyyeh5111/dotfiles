# Global just recipes, linked to ~/.justfile by setup.sh. `just` looks for a
# justfile in every parent folder, so `just <project> <recipe>` works from
# anywhere under ~ (elsewhere, or inside a repo with its own justfile, use
# `just -g ...`). Each project is a module in this folder.
#
# Module paths assume this repo lives at ~/dotfiles.

# just has no module aliases, so each alias loads the same file again as a
# hidden module: `just a build` runs `just mxapi build`.

mod mxapi '~/dotfiles/just/mxapi.just'
mod mix '~/dotfiles/just/mix.just'
mod devhub '~/dotfiles/just/devhub.just'
mod pages '~/dotfiles/just/pages.just'
mod vpn '~/dotfiles/just/vpn.just'

[private]
mod a '~/dotfiles/just/mxapi.just'
[private]
mod b '~/dotfiles/just/mix.just'
[private]
mod c '~/dotfiles/just/devhub.just'
[private]
mod d '~/dotfiles/just/pages.just'
[private]
mod e '~/dotfiles/just/vpn.just'

# List every recipe, in file order so modules follow their aliases
[private]
default:
    @{{just_executable()}} --justfile {{justfile()}} --list --list-submodules --unsorted
    @echo; echo 'Aliases: a = mxapi, b = mix, c = devhub, d = pages, e = vpn'
